\usepackage{minted}
\setminted{
    labelposition=topline,
    %
    % frame=lines,
    frame=single,
    framerule=1pt,
    framesep=10pt,
    rulecolor=Gray,
    bgcolor=LightGray,
    %
    % codetagify={NOTE, TODO, BUG},
    %
    baselinestretch=1.2,
    linenos=true,
    numberblanklines=true,
    %
    tabsize=4,
    obeytabs=true,
    autogobble=true,
    % gobble=?,
    %
    breaklines=true,
    breakafter={
        \symbol{32} % space
        \symbol{44} % ,
        \symbol{46} % .
        \symbol{93} % ]
        \symbol{125} % }
    },
    breakbefore={
        \symbol{43} % +
        \symbol{45} % -
        \symbol{42} % *
        \symbol{47} % /
        \symbol{91} % [
        \symbol{123} % {
    },
    samepage=true,
    %
}
